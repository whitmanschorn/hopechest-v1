{
  "mcpServers": {
    "hopechest-staging": {
      "type": "http",
      "url": "https://hopechest-staging.vercel.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${HOPECHEST_STAGING_API_KEY:-not-set}"
      }
    },
    "hopechest-local": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${HOPECHEST_LOCAL_API_KEY:-not-set}"
      }
    }
  }
}
