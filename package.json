{
  "name": "hopechest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "pr-size": "node scripts/pr-size.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:smoke",
    "postinstall": "prisma generate",
    "db:up": "docker start hopechest-pg 2>/dev/null || docker run -d --name hopechest-pg -e POSTGRES_PASSWORD=hopechest -e POSTGRES_DB=hopechest -p 54329:5432 pgvector/pgvector:pg18",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed.ts",
    "db:reset": "node scripts/db-reset.ts",
    "db:pull": "node scripts/db-pull.ts",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code && node scripts/check-migrations.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/dates": "^9.8.0",
    "@mantine/dropzone": "^9.8.0",
    "@mantine/form": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tabler/icons-react": "^3.51.0",
    "@vercel/blob": "^2.9.0",
    "dayjs": "^1.11.23",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.10.0",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
