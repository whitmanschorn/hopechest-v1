# Copy to .env.local. Never commit real values: this repository is public.

# Which deployment this is: development | preview | staging | production
HOPECHEST_ENV=development
# The one family this deployment serves.
CHEST_NAME="Bluth family"
CHEST_SLUG=bluth

# Postgres. The app uses the pooled URL; migrations use the direct one.
# These defaults match `npm run db:up`. On Vercel the Neon integration sets both.
DATABASE_URL=postgresql://postgres:hopechest@localhost:54329/hopechest
DATABASE_URL_UNPOOLED=postgresql://postgres:hopechest@localhost:54329/hopechest
