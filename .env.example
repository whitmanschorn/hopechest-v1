# Copy to .env.local. Never commit real values: this repository is public.

# Which deployment this is: development | preview | staging | production
HOPECHEST_ENV=development
# The one family this deployment serves.
CHEST_NAME="Bluth family"
CHEST_SLUG=bluth

# Postgres. The app uses the pooled URL; migrations use the direct one.
# These defaults match `npm run db:up`. On Vercel the Neon integration sets both.
DATABASE_URL=postgresql://postgres:hopechest@localhost:54329/hopechest
DATABASE_URL_UNPOOLED=postgresql://postgres:hopechest@localhost:54329/hopechest

# Phone numbers that become admins on first sign-in (comma-separated). This is
# how the first account is created. 555-01xx numbers are test numbers.
ADMIN_PHONES=+12025550101
# Extra numbers that get on-screen codes outside production (never in production).
TEST_PHONE_ALLOWLIST=
# If set (six digits), test numbers sign in with this code and nothing is shown
# on screen. Required for test numbers to work at all when HOPECHEST_ENV=staging.
TEST_LOGIN_CODE=

# The demo door (/try): with this password, anyone can sign in as any family
# member and look around. At least 12 characters; leave empty for no door. Never
# honoured when HOPECHEST_ENV=production.
DEMO_PASSWORD=local-demo-password

# The language model that reads facts out of what people write (and will answer
# questions). With a key, DeepSeek is used. Without one, a stand-in that reads a
# few fixed sentence shapes is used outside production, and nothing in production.
# LLM_PROVIDER forces one: deepseek | fake | none.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# LLM_PROVIDER=

# Twilio. Required in production; optional elsewhere (test numbers work without it).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# For invite texts: one of these.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
